# ── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=reviews
DELAY_SECONDS=0.05

# ── Spark ──────────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# ── PostgreSQL (métadonnées applicatives + base Airflow) ───────────────────
POSTGRES_USER=bigdata
POSTGRES_PASSWORD=bigdata

# ── Airflow ─────────────────────────────────────────────────────────────────
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ── API ─────────────────────────────────────────────────────────────────────
TOP_N=10
# DATABASE_URL est injecté par docker-compose ; en local :
# DATABASE_URL=postgresql://bigdata:bigdata@localhost:5432/recommendation
